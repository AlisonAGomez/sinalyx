# Sinalyx - exemplo de configuracao de ambiente
#
# Use este arquivo como base:
#   copy .env.example .env
#
# Nunca versione o arquivo .env real. Para gerar um segredo forte:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"

# Perfil do ambiente:
# - local: desenvolvimento na maquina local
# - demo: apresentacao controlada
# - production: producao real
SINALYX_ENV=local

# Limite do corpo de POST /analyze/pfsense, incluindo multipart: 50 MiB em bytes.
SINALYX_LIMITE_UPLOAD_BYTES=52428800

# Origens permitidas para o frontend acessar a API.
# Em demo/producao, troque pelos dominios/hosts reais separados por virgula.
SINALYX_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://sinalyx.local,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Banco PostgreSQL
# Valores abaixo servem somente ao perfil local. Em demo/producao, defina
# POSTGRES_PASSWORD e DATABASE_URL com credenciais proprias, fora do Git.
DATABASE_ENABLED=true
POSTGRES_DB=sinalyx
POSTGRES_USER=sinalyx
POSTGRES_PASSWORD=sinalyx
DATABASE_URL=postgresql://sinalyx:sinalyx@postgres:5432/sinalyx

# Portas publicadas pelo Docker Compose.
# Por padrão, todas as portas publicadas ficam somente em localhost.
# Exposição externa exige perfil demo/production, segredo forte e TLS apropriado.
SINALYX_API_BIND=127.0.0.1
SINALYX_API_HOST_PORT=8000
SINALYX_FRONTEND_BIND=127.0.0.1
SINALYX_FRONTEND_HOST_PORT=80
SINALYX_POSTGRES_BIND=127.0.0.1
SINALYX_POSTGRES_HOST_PORT=5432

# Frontend empacotado no Docker.
# No Docker, o Nginx do frontend encaminha /api para a API FastAPI.
VITE_API_BASE_URL=/api
VITE_APP_ENV=local

# Runtime/IA
SINALYX_RUNTIME_PROFILE=balanced

# Opcional: raiz dos dados gravaveis (uploads, resultados e estados live).
# Vazio preserva <projeto>/data; caminho relativo parte de <projeto>.
# Em uma instalacao Windows, use uma pasta
# gravavel, como C:\ProgramData\Sinalyx. Os modelos permanecem separados
# no local atual ate a configuracao especifica de modelos ser introduzida.
SINALYX_DATA_DIR=

# Opcional: raiz do store de modelos oficiais, independente de SINALYX_DATA_DIR.
# Vazio preserva <projeto>/data/models; caminhos relativos partem de <projeto>.
# Em uma futura instalacao Windows, pode apontar para um diretorio somente
# leitura do aplicativo, como C:\Program Files\Sinalyx\models.
SINALYX_MODELS_DIR=

# Autenticacao/JWT
# Somente perfil local aceita fallback de desenvolvimento. Em demo/production,
# gere um valor aleatório único de pelo menos 32 caracteres, sem padrões repetidos.
SINALYX_AUTH_SECRET_KEY=
SINALYX_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Login: limite por cliente, em memória por processo, incluindo tentativas válidas.
SINALYX_LOGIN_MAX_TENTATIVAS=10
SINALYX_LOGIN_JANELA_SEGUNDOS=60
SINALYX_LOGIN_MAX_CLIENTES=4096
# Proxies controlados que podem informar o IP do cliente ao Uvicorn.
# Vazio não confia em nenhum proxy. Não usar *; veja docs/fase2c_hardening.md.
FORWARDED_ALLOW_IPS=

# Seed do administrador inicial.
# Se SINALYX_ADMIN_PASSWORD estiver vazio, o admin nao sera criado automaticamente.
SINALYX_ADMIN_NAME=Administrador Sinalyx
SINALYX_ADMIN_EMAIL=admin@sinalyx.local

# Worker live: estado persistido prevalece sobre AUTOSTART após o primeiro boot.
SINALYX_PFSENSE_WORKER_INTERVAL_SECONDS=5
SINALYX_PFSENSE_WORKER_AUTOSTART=false

# Retenção de artefatos locais auxiliares em live/runs; não altera PostgreSQL.
# Desative com false. Valores 0 desativam apenas o respectivo limite.
# Defaults conservadores, ajustáveis conforme o volume operacional.
SINALYX_LIVE_RUN_RETENTION_ENABLED=true
SINALYX_LIVE_RUN_RETENTION_MAX_COUNT=2000
SINALYX_LIVE_RUN_RETENTION_MAX_AGE_HOURS=24
SINALYX_ADMIN_PASSWORD=
SINALYX_SUPER_ADMIN_EMAIL=admin@sinalyx.local

# Coleta live do pfSense via SSH/SFTP
SINALYX_PFSENSE_HOST=
SINALYX_PFSENSE_SSH_PORT=22
SINALYX_PFSENSE_USER=
SINALYX_PFSENSE_PASSWORD=
SINALYX_PFSENSE_KEY_PATH=
SINALYX_PFSENSE_REMOTE_LOG_PATH=/var/log/filter.log
# Vazios seguem SINALYX_DATA_DIR; valores explicitos prevalecem.
SINALYX_PFSENSE_LOCAL_LOG_PATH=
SINALYX_PFSENSE_COLLECTOR_STATE_PATH=
SINALYX_PFSENSE_PARSER_STATE_PATH=
SINALYX_PFSENSE_CONNECT_TIMEOUT=15

# Cadastre a chave verificada por canal independente; nunca aceitar automaticamente.
# Vazio usa o known_hosts do usuário do processo; em Docker, forneça arquivo montado.
SINALYX_PFSENSE_KNOWN_HOSTS_PATH=
# Opção legada: true agora é rejeitado em qualquer perfil.
SINALYX_PFSENSE_ALLOW_UNKNOWN_HOST=false
