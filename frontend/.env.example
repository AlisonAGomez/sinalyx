# Sinalyx frontend - exemplo de ambiente Vite
#
# Use como base:
#   copy .env.example .env
#
# Para build Docker, use /api para passar pelo Nginx do frontend.
# Para desenvolvimento com Vite fora do Docker, use http://localhost:8000.
VITE_API_BASE_URL=/api

# Identificacao opcional do perfil exibido/diagnosticado no build.
VITE_APP_ENV=local
